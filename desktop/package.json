{
  "name": "nexnova-hrm-desktop",
  "version": "1.0.0",
  "description": "NexNova Technologies Enterprise HRM Desktop Application",
  "main": "dist/main.js",
  "scripts": {
    "build:ts": "tsc",
    "dev": "tsc && electron .",
    "start": "electron .",
    "dist:win": "tsc && electron-builder --win"
  },
  "keywords": ["hrm", "electron", "enterprise", "nexnova", "desktop"],
  "author": "NexNova Technologies JSC",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^20.17.0",
    "electron": "^31.3.1",
    "electron-builder": "^24.13.3",
    "typescript": "^5.6.3"
  },
  "build": {
    "appId": "tech.nexnova.hrm.desktop",
    "productName": "NexNova HRM",
    "directories": {
      "output": "release"
    },
    "win": {
      "target": ["nsis", "portable"],
      "icon": "resources/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
